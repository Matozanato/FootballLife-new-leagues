{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FL27 Mod Manager",
  "version": "1.3.2",
  "identifier": "uk.hawks.fl27mm",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FL27 Mod Manager",
        "width": 1320,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Hawks",
    "copyright": "All makers",
    "category": "Utility",
    "shortDescription": "Mod manager, game map and mod studio for SP Football Life 2027",
    "longDescription": "Reads and writes Sider's pack order, decodes CRIWARE CPK archives, Fox Engine textures, BC5 normal maps and BC7, validates database tables, explains what every part of an FL27 install does, and includes a Mod Studio with a workspace tree, a tabbed editor and one-click pack install.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "FL27 Mod Manager"
      }
    }
  }
}
